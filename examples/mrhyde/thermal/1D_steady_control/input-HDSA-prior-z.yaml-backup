%AML 1.1
---
ANONYMOUS:
  verbosity: 0
  debug level: 0
  profile: false
  Mesh:
    dimension: 1
    element type: interval
    xmin: 0.0
    xmax: 1.0
    NX: 199
  Parameters: 
    sourcefield: 
      type: HGRAD
      order: 1
      usage: discretized
      initial_value: 1.0
  Functions:
    ellipticPrior source: sourcefield
    ellipticPrior diffusion:"2.0"
    ellipticPrior reaction:"1.0"
  Physics: 
    modules: ellipticPrior
  Discretization:
    order:
      e: 1
    quadrature: 2
  Solver:
    solver: steady-state
    workset size: 1
    nonlinear TOL: 1.0e-07
    max nonlinear iters: 2
    matrix free: true
  Analysis: 
    analysis type: forward
  Postprocess: 
    compute errors: false
    write solution: false
...
