# Ensure that the MrHyDE executable has been linked to the current directory under the name "mrhyde"

#!/bin/bash

# Number of processors
NPROCS=4

# Set links to optimization solution
for ((i=0; i<NPROCS; i++)); do
    ln -s "../optimization/output_lofi_opt.exo.${NPROCS}.${i}" .
done

# Copy to hifi input files
for ((i=0; i<NPROCS; i++)); do
    cp "output_lofi_opt.exo.${NPROCS}.${i}" "hifi_z1.exo.${NPROCS}.${i}"
done

# Solve forward problem
mpiexec -n "$NPROCS" mrhyde

# Change file names
for ((i=0; i<NPROCS; i++)); do
    mv "output.exo.${NPROCS}.${i}" "output_hifi_1.exo.${NPROCS}.${i}"
done
