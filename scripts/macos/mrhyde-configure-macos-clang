EXTRA_ARGS=$@

# Modules installed using Homebrew: open-mpi, boost, hdf5-mpi, netcdf, cmake, ninja
# May also need to use Homebrew to install: zlib, pnetcdf, libx11
 
[ "$(uname)" = "Darwin" ] && BASE_DIR="$HOME" || BASE_DIR="/Users/joshart"
rm CMakeCache.txt
rm -rf CMakeFiles/
 
TRILINOS_HOME="$BASE_DIR/software/Trilinos"
 
TRILINOS_INSTALL="$BASE_DIR/software/Trilinos/trilinos-clang"

HDSALIB_HOME="$BASE_DIR/software/HdsaLib" 
 
MRHYDE_HOME="$BASE_DIR/software/MrHyDE"
 
MRHYDE_INSTALL="$BASE_DIR/software/MrHyDE/install"
 
cmake \
-GNinja \
-D Trilinos_SRC_DIR=${TRILINOS_HOME} \
-D Trilinos_INSTALL_DIR=${TRILINOS_INSTALL} \
-D HdsaLib_SRC_DIR=${HDSALIB_HOME} \
-D CMAKE_INSTALL_PREFIX:PATH=${MRHYDE_INSTALL} \
-D CMAKE_CXX_STANDARD=20 \
-D CMAKE_CXX_FLAGS:STRING="-Wall" \
-D MrHyDE_ENABLE_SANDBOX=ON \
-D MrHyDE_MAX_DERIVS=64 \
-D MrHyDE_BUILD_DOXYGEN=false \
-D MrHyDE_ENABLE_HDSA=ON \
${EXTRA-ARGS} \
${MRHYDE_HOME}